# Absolute path to the provision data directory.
# All generated configs, user data, and the registry file live here.
PROVISION_DIR=/opt/provision

# Port the provision API is exposed on (container listens on 8000).
PROVISION_API_PORT=8765

# Port nginx listens on for proxying user services.
NGINX_HTTP_PORT=80

# Task manager — per-task isolated log files.
# Directory where each async task writes its own .log file (streamed via SSE).
# Default: $PROVISION_DIR/generated/task_logs
# TASK_LOG_DIR=${PROVISION_DIR}/generated/task_logs

# How long finished tasks and their log files are kept (seconds).
# Default: 604800 (7 days)
# TASK_TTL_SECONDS=604800

# Maximum number of tasks retained in memory; oldest evicted when exceeded.
# Default: 1000
# TASK_MAX_COUNT=1000
